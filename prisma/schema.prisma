// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Doctor {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  clinicName         String
  logoUrl            String?
  address            String?
  mapsUrl            String?  // Google Maps share URL for "Get Directions"
  websiteUrl         String?  // Clinic website
  phone              String?
  specialty          String   @default("General Physician")
  themeColor         String   @default("#3B82F6")
  qualifications     String?  // e.g. "MBBS, MD (Cardiology), FACC"
  slotDurationMins   Int      @default(15)
  // JSON: { monday: { open: true, morning: {start:"09:00", end:"13:00"}, evening: {start:"17:00", end:"20:00"} }, ... }
  timings            Json     @default("{}")
  // JSON: { qrCodeUrl: string, bankDetails: string, upiId: string }
  paymentDetails     Json     @default("{}")
  // JSON: [24, 1]  (hours before appointment)
  reminderIntervals  Json     @default("[24, 1]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  appointments       Appointment[]
  blockedSlots       BlockedSlot[]
  passwordResetTokens PasswordResetToken[]

  @@map("doctors")
}

model Patient {
  id             String   @id @default(cuid())
  phone          String   @unique
  name           String
  dob            DateTime
  medicalHistory String?  @db.Text
  email          String?  // Optional – used for email reminders
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointments   Appointment[]
  prescriptions  Prescription[]
  payments       Payment[]

  @@map("patients")
}

model Appointment {
  id                String            @id @default(cuid())
  patientId         String
  doctorId          String
  startTime         DateTime
  endTime           DateTime
  status            AppointmentStatus @default(BOOKED)
  chiefComplaint    String?           @db.Text
  consultationNotes String?           @db.Text
  reminderSent24h   Boolean           @default(false)
  reminderSent1h    Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  patient           Patient           @relation(fields: [patientId], references: [id])
  doctor            Doctor            @relation(fields: [doctorId], references: [id])
  prescription      Prescription?
  payment           Payment?

  @@index([doctorId, startTime])
  @@index([patientId, startTime])
  @@map("appointments")
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

model BlockedSlot {
  id        String   @id @default(cuid())
  doctorId  String
  startTime DateTime
  endTime   DateTime
  reason    String?
  createdAt DateTime @default(now())

  doctor    Doctor   @relation(fields: [doctorId], references: [id])

  @@index([doctorId, startTime])
  @@map("blocked_slots")
}

model Prescription {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  patientId     String
  diagnosis     String?     @db.Text
  // JSON: [{ name, dosage, frequency, duration, instructions }]
  medicines     Json        @default("[]")
  notes         String?     @db.Text
  pdfPath       String?     // GCS path or local path
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patient       Patient     @relation(fields: [patientId], references: [id])

  @@map("prescriptions")
}

model Payment {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  patientId     String
  amount        Decimal     @db.Decimal(10, 2)
  mode          PaymentMode @default(CASH)
  paidAt        DateTime    @default(now())
  notes         String?     @db.Text
  receiptPdfPath String?    // GCS path or local path
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patient       Patient     @relation(fields: [patientId], references: [id])

  @@map("payments")
}

enum PaymentMode {
  CASH
  UPI
  CARD
  OTHER
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  doctorId  String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  doctor    Doctor   @relation(fields: [doctorId], references: [id])

  @@map("password_reset_tokens")
}
