.git
.gitignore
node_modules
.next
out
build
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
*.tsbuildinfo
next-env.d.ts

# Secrets must never enter the Cloud Build context. Runtime configuration
# is injected via Secret Manager at deploy time (see deploy.ps1) instead
# of being baked into the build.
.env
.env.*

# Exception: .env.production is regenerated fresh by deploy.ps1 on every
# run, containing ONLY the NEXT_PUBLIC_* subset. Those values aren't
# secrets — Firebase's client config is designed to be public, and access
# control lives in Firestore/Storage security rules, not in hiding this
# key. They're needed at build time because Next.js inlines NEXT_PUBLIC_*
# vars into the browser bundle at compile time; Cloud Run's runtime
# secrets can't reach client-side code that way.
!.env.production
